# Creditcoin CC3 testnet
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Ethereum Sepolia source chain (chainKey 1). A source RPC is optional for monitoring.
SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_KEY=1

# Set after local/testnet deployment. Never commit private keys.
VEYRONIS_ESCROW_ADDRESS=
VEYRONIS_VERIFIER_ADDRESS=
VEYRONIS_EVIDENCE_REGISTRY_ADDRESS=
VEYRONIS_VERIFIER_PRIVATE_KEY=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
DATABASE_URL=postgresql://veyronis:veyronis@localhost:5432/veyronis

# Frontend: public values only
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
