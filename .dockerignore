.git
.gitignore

# Installed dependencies and build outputs
node_modules
**/node_modules
**/dist
**/.next
**/*.tsbuildinfo
coverage
out
cache
broadcast
contracts/cache
contracts/out
contracts/broadcast

# Environment files: keep examples, never copy real credentials
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Local database volumes and runtime state
local
**/pgdata
**/postgres-data
**/*.sqlite
**/*.sqlite3
**/*.db

# Logs and temporary files
*.log
*.err
*.tmp
*.temp
tmp
temp
logs
